            "command": "export MY_INSTALL_DIR=$HOME/.local; export PATH=\"$MY_INSTALL_DIR/bin:$PATH\"; ./Devtools/build.sh ",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file",
